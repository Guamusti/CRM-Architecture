# Copia a .env y rellena. NUNCA commitees .env
NODE_ENV=development
PORT=3000

# PostgreSQL / Supabase (connection string del pooler de Supabase si aplica)
DATABASE_URL=postgres://user:password@localhost:5432/zyra_crm
# Pon a "true" si el proveedor exige TLS (Supabase: true)
DATABASE_SSL=false

# Secreto JWT: mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS, separados por coma. En producción, dominios exactos.
CORS_ORIGINS=http://localhost:3000
